# Job Radar Environment Variables

# Server Config
PORT=5000
HOST=0.0.0.0

# Optional API Keys for External Job Sources (Leave blank if not available; fallbacks will be used)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=

# Optional LLM API Key for AI Matching Explanations & Resume Feedback
# Gemini / OpenAI compatible key
GEMINI_API_KEY=
OPENAI_API_KEY=

# Crawler Configuration
JOBSPY_ENABLED=true
ADZUNA_ENABLED=true
JOOBLE_ENABLED=true
COMPANY_ENABLED=true
MAX_JOBS_PER_SOURCE=30
